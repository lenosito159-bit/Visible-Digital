# ---------- Servidor ----------
PORT=3000
DATABASE_URL=postgres://perupos:perupos@localhost:5432/perupos
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-48-bytes
# Orígenes permitidos (la app móvil no lo necesita; sirve para un panel web).
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# ---------- Datos del negocio (se usan en el seed inicial; luego se editan en la app) ----------
BUSINESS_RUC=20123456786
BUSINESS_RAZON_SOCIAL=INVERSIONES DOÑA ROSA E.I.R.L.
BUSINESS_NOMBRE_COMERCIAL=Bodega Doña Rosa
BUSINESS_DIRECCION=Jr. Las Magnolias 245, San Juan de Lurigancho, Lima
BUSINESS_UBIGEO=150132
BUSINESS_PHONE=987654321
# NRUS | RER | RMT | GENERAL
BUSINESS_TAX_REGIME=RMT
# PIN iniciales de los usuarios de prueba (cámbialos luego en Admin → Usuarios).
SEED_ADMIN_PIN=1234
SEED_VENDEDOR_PIN=1111
SEED_AGENTE_PIN=2222

# ---------- Yape / Plin con QR interoperable (TAYPI) ----------
# mock = modo de prueba sin cobros reales | taypi = cobros reales
PAYMENTS_PROVIDER=mock
TAYPI_PUBLIC_KEY=taypi_pk_test_xxxxxxxx
TAYPI_SECRET_KEY=taypi_sk_test_xxxxxxxx
TAYPI_WEBHOOK_SECRET=
# https://sandbox.taypi.pe (pruebas) | https://app.taypi.pe (producción)
TAYPI_BASE_URL=https://sandbox.taypi.pe
# Tiempo para pagar el QR (segundos).
QR_TTL_SECONDS=120
# Solo modo mock: el QR se "paga" solo tras N segundos (0 = usar el botón "Simular pago").
MOCK_AUTOPAY_SECONDS=0

# ---------- Comprobantes electrónicos (PSE) ----------
# mock = simula la aceptación de SUNAT | nubefact | none
PSE_PROVIDER=mock
# "RUTA" y "TOKEN" que te da Nubefact al activar la API.
NUBEFACT_URL=https://api.nubefact.com/api/v1/tu-ruta-unica
NUBEFACT_TOKEN=

# ---------- Notificaciones push (Expo) ----------
PUSH_ENABLED=true
# Opcional: token de acceso de Expo si activaste "push security".
EXPO_ACCESS_TOKEN=
JOBS_ENABLED=true
ALERTS_INTERVAL_MINUTES=15
