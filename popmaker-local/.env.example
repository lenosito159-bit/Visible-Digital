# Copia este archivo como .env y rellena tus claves. .env no se sube a git.
# run_workflow.sh y los scripts lo cargan solos. Para usar Claude Code en modo
# interactivo, cárgalo antes de abrirlo:  set -a; source .env; set +a; claude

# Google AI Studio (obligatoria para generar imágenes)
GEMINI_API_KEY=

# Almacenamiento S3-compatible (opcional; o todas o ninguna)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_REGION=auto

# Cómo genera imágenes el hook: mcp (defecto) | script | off
POPMAKER_IMAGE_MODE=mcp
