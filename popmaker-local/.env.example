# Copia este archivo como .env y rellena tus claves. .env está en .gitignore.
# Los scripts y run_workflow.sh lo cargan solos. Para Claude Code interactivo, cárgalo
# antes de abrirlo:  set -a; source .env; set +a; claude

# [OBLIGATORIA] Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [OPCIONAL] Almacenamiento S3-compatible para obtener URLs públicas.
# O todas o ninguna (si defines solo algunas, el servidor MCP no arranca).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_REGION=auto

# [OPCIONAL] Ajustes del pipeline
# POPMAKER_CALIDAD=fast        # fast (1K) | balanced (2K) | quality (4K)
# POPMAKER_VIA=auto            # auto (MCP y si falla API) | mcp | api
# POPMAKER_IMAGENES=off        # desactiva la generación de imágenes en el hook
# GEMINI_TEXT_MODEL=gemini-flash-latest   # modelo para generate_ideas.py sin Claude
