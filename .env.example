# Copia este archivo como .env y rellena los valores de tu API.
# El archivo .env no se sube a GitHub (está en .gitignore).

# URL base de la API que quieres testear, sin barra final.
API_BASE_URL=

# Token de acceso, si la API lo requiere (se envía como "Authorization: Bearer ...").
API_TOKEN=

# Ruta que se usa para el test básico de disponibilidad.
API_HEALTH_PATH=/
