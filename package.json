{
  "name": "api-testing",
  "version": "1.0.0",
  "description": "Proyecto para testear APIs con Vitest y catálogo de APIs públicas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "buscar": "node scripts/buscar-api.js",
    "catalogo:actualizar": "node scripts/actualizar-catalogo.js"
  },
  "devDependencies": {
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
